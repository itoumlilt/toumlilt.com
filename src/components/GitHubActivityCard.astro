---
import { profile } from '../data/profile';
import type { GitHubActivityFeed } from '../lib/github-activity';

interface Props {
  feed: GitHubActivityFeed;
  displayLimit: number;
  showContributionChart: boolean;
}

const { feed, displayLimit, showContributionChart } = Astro.props;
const items = feed.items.slice(0, displayLimit);
const generatedAt = feed.generatedAt
  ? new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(new Date(feed.generatedAt))
  : null;

function formatActivityTime(value: string) {
  const date = new Date(value);

  if (Number.isNaN(date.getTime())) {
    return '';
  }

  const diffMs = Date.now() - date.getTime();
  const diffDays = Math.max(0, Math.floor(diffMs / 86_400_000));

  if (diffDays === 0) {
    return 'today';
  }

  if (diffDays === 1) {
    return '1 day ago';
  }

  if (diffDays < 45) {
    return `${diffDays} days ago`;
  }

  return new Intl.DateTimeFormat('en', { dateStyle: 'medium' }).format(date);
}
---

<article class="dashboard-card github-card github-activity-card">
  <h2>My Github Feed</h2>

  {
    showContributionChart && (
      <a class="github-chart-link" href={feed.sourceUrl} aria-label="GitHub profile">
        <img src="/assets/images/github-chart.png" alt="GitHub contributions chart" loading="lazy" />
      </a>
    )
  }

  <a class="github-profile-row" href={feed.sourceUrl}>
    <div>
      <strong>{profile.name}</strong>
      <span>{feed.username}</span>
    </div>
    <img src="/assets/images/profile.png" alt="" loading="lazy" />
  </a>

  {
    items.length > 0 ? (
      <ol class="github-activity-list" aria-label="Recent GitHub activity">
        {
          items.map((item) => (
            <li class="github-activity-item">
              <span class="svg-icon github-activity-icon" style={`--icon-url: url('${item.icon}')`} aria-hidden="true" />
              <div>
                <time datetime={item.createdAt}>{formatActivityTime(item.createdAt)}</time>
                <p class="github-activity-summary">
                  {
                    item.summaryParts.map((part) => (
                      part.href ? (
                        <a class={part.strong ? 'is-strong' : undefined} href={part.href}>
                          {part.text}
                        </a>
                      ) : (
                        <span class={part.strong ? 'is-strong' : undefined}>{part.text}</span>
                      )
                    ))
                  }
                </p>
                {item.excerpt && <p class="github-activity-excerpt">{item.excerpt}</p>}
              </div>
            </li>
          ))
        }
      </ol>
    ) : (
      <p class="github-activity-empty">GitHub activity is unavailable right now.</p>
    )
  }

  <footer class="github-activity-footer">
    <span>Public Activity</span>
    <a href={feed.sourceUrl}>
      {generatedAt ? `Updated ${generatedAt}` : 'GitHub Profile'}
    </a>
  </footer>
</article>
