---
import { profile } from '../data/profile';
---

<section class="dashboard-card side-card">
  <h2>Web Profiles</h2>
  <ul class="profile-list">
    {
      profile.links.map((link) => (
        <li>
          <a href={link.href}>
            <span class="svg-icon profile-icon" style={`--icon-url: url('${link.icon}')`} aria-hidden="true"></span>
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>
</section>
