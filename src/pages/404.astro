---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Not found" description="Page not found.">
  <section class="page-heading">
    <div class="section-inner">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p>The page may have moved during the site modernization. The writing archive is a good next stop.</p>
      <p><a class="button-link" href="/writing/">Go to writing</a></p>
    </div>
  </section>
</BaseLayout>
